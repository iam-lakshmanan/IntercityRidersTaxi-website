# Replace the provisional domain and contact details before launch.
NEXT_PUBLIC_SITE_URL=https://intercityriders.example
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_EMAIL=
# Browser key: restrict to your website origins and Maps JavaScript + Places APIs.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Server key: enable Directions API and restrict to your server IP.
GOOGLE_MAPS_SERVER_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Random secret, at least 32 characters, used to sign short-lived quotes.
QUOTE_SIGNING_SECRET=
# Deployment must provide a trusted client IP header, e.g. x-real-ip.
TRUSTED_IP_HEADER=
